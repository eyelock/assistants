{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/guard-rm.sh" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "If the prompt mentions production, remind the user to use the staging profile."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "agent", "prompt": "Check that every TODO the user asked for is done." }
        ]
      }
    ]
  }
}
