{
  "$schema": "https://eyelock.github.io/ynh/schema/plugin.schema.json",
  "name": "tester",
  "version": "0.1.2",
  "description": "Testing and quality assurance persona",
  "default_vendor": "claude",
  "includes": [
    {
      "git": "https://github.com/eyelock/assistants",
      "path": "skills/dev",
      "ref": "@eyelock-assistants/dev-skills@0.2.0",
      "pick": ["skills/dev-quality"]
    },
    {
      "git": "https://github.com/eyelock/assistants",
      "path": "skills/tech",
      "ref": "@eyelock-assistants/tech-skills@0.2.1",
      "pick": ["skills/go-lang"]
    }
  ]
}
