{
  "$schema": "https://eyelock.github.io/ynh/schema/plugin.schema.json",
  "name": "david",
  "version": "0.1.2",
  "description": "David's personal development persona with full skill set",
  "default_vendor": "claude",
  "includes": [
    {
      "git": "https://github.com/eyelock/assistants",
      "path": "skills/dev",
      "ref": "@eyelock-assistants/dev-skills@0.2.0",
      "pick": [
        "skills/dev-project",
        "skills/dev-quality",
        "skills/dev-review",
        "skills/dev-security",
        "skills/dev-backend",
        "skills/dev-ui",
        "skills/dev-debug"
      ]
    },
    {
      "git": "https://github.com/eyelock/assistants",
      "path": "skills/tech",
      "ref": "@eyelock-assistants/tech-skills@0.2.1",
      "pick": ["skills/go-lang"]
    },
    {
      "git": "https://github.com/eyelock/assistants",
      "path": "skills/infra",
      "ref": "@eyelock-assistants/infra-skills@0.2.0",
      "pick": ["skills/gh-os-repo", "skills/terraform-backend-aws"]
    },
    {
      "git": "https://github.com/eyelock/assistants",
      "path": "skills/pause",
      "ref": "@eyelock-assistants/pause-skills@0.1.1",
      "pick": ["skills/help-me-answer", "skills/take-a-moment"]
    }
  ]
}
