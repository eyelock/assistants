diff --git a/internal/payments/retry.go b/internal/payments/retry.go
new file mode 100644
--- /dev/null
+++ b/internal/payments/retry.go
@@ -0,0 +1,25 @@
+package payments
+
+import (
+	"context"
+	"time"
+)
+
+// withRetry calls fn until it succeeds, the attempts run out, or ctx is done.
+// It waits between attempts, doubling the wait each time.
+func withRetry(ctx context.Context, attempts int, fn func() error) error {
+	wait := 200 * time.Millisecond
+	var err error
+	for i := 0; i < attempts; i++ {
+		if err = fn(); err == nil || !retryable(err) {
+			return err
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(wait):
+		}
+		wait *= 2
+	}
+	return err
+}
