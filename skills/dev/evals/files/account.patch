diff --git a/src/account/routes.ts b/src/account/routes.ts
new file mode 100644
--- /dev/null
+++ b/src/account/routes.ts
@@ -0,0 +1,44 @@
+import crypto from "node:crypto";
+import { promises as fs } from "node:fs";
+import path from "node:path";
+import { Router } from "express";
+import { db } from "../db";
+import { logger } from "../logger";
+
+export const router = Router();
+const AVATAR_DIR = "/var/app/avatars";
+
+router.post("/login", async (req, res) => {
+  logger.info("login attempt", req.body);
+  const { rows } = await db.query("SELECT id, password_hash FROM users WHERE email = $1", [
+    req.body.email,
+  ]);
+  const user = rows[0];
+  const hash = crypto.createHash("sha256").update(req.body.password).digest("hex");
+  if (!user || user.password_hash !== hash) return res.status(401).end();
+  const sessionId = crypto.randomBytes(32).toString("hex");
+  await db.query("INSERT INTO sessions (id, user_id) VALUES ($1, $2)", [sessionId, user.id]);
+  res.cookie("sid", sessionId, { httpOnly: true, secure: true, sameSite: "strict" });
+  res.status(204).end();
+});
+
+router.get("/invoices/:id", async (req, res) => {
+  const { rows } = await db.query("SELECT * FROM invoices WHERE id = $1", [req.params.id]);
+  if (!rows[0]) return res.status(404).end();
+  res.json(rows[0]);
+});
+
+router.post("/webhooks/billing", async (req, res) => {
+  if (req.get("x-webhook-token") !== process.env.BILLING_WEBHOOK_TOKEN) {
+    return res.status(401).end();
+  }
+  await db.query("UPDATE invoices SET status = $1 WHERE id = $2", [req.body.status, req.body.id]);
+  res.status(204).end();
+});
+
+router.post("/avatar", async (req, res) => {
+  const file = req.files.avatar;
+  if (!file.name.endsWith(".png")) return res.status(400).end();
+  await fs.writeFile(path.join(AVATAR_DIR, file.name), file.data);
+  res.status(204).end();
+});
